#cloud-config
# Placeholders are substituted by .github/workflows/test-module-qemu.yml.
hostname: ns8-ci
fqdn: ns8-ci.test.local
prefer_fqdn_over_hostname: true
# cloud-init's own template maps the FQDN to loopback, which is wrong for a
# WireGuard endpoint. The real entry is written in runcmd instead.
manage_etc_hosts: false

disable_root: false
ssh_pwauth: false
users:
  # No lock_passwd here: root has no password, cc_users_groups handles the
  # password before the keys, and unlocking an empty one raises before the
  # authorized_keys ever get written.
  - name: root
    ssh_authorized_keys:
      - "@@SSH_PUBKEY@@"

growpart:
  mode: auto
  devices: ["/"]
resize_rootfs: true

write_files:
  - path: /etc/ssh/sshd_config.d/00-ci-root.conf
    permissions: '0600'
    content: |
      PermitRootLogin prohibit-password
      PubkeyAuthentication yes
      UseDNS no
  # The module image is pulled rootless by the module user, which does not exist
  # yet at provisioning time, so its own registries.conf cannot be seeded.
  - path: /etc/containers/registries.conf.d/010-ns8ci.conf
    permissions: '0644'
    content: |
      [[registry]]
      location = "@@GW_IP@@:5000"
      insecure = true

runcmd:
  - [ bash, -c, "echo '@@VM_IP@@ ns8-ci.test.local ns8-ci' >> /etc/hosts" ]
  - [ systemctl, restart, sshd ]

final_message: "cloud-init done after $UPTIME seconds"
